{
  "name": "ripcord",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts",
    "build": "prisma generate && next build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "admin": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "test:load": "tsx --env-file-if-exists=.env scripts/load-test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "0.577.0",
    "next": "16.3.8",
    "nodemailer": "10.0.13",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tsx": "4.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/nodemailer": "7.0.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.3.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "esbuild": "0.28.2"
  }
}
