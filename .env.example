DATABASE_URL=postgresql://ripcord:ripcord@localhost:5432/ripcord?schema=public
APP_URL=http://localhost:3000
PORT=3000
UPLOAD_DIR=./uploads
# Docker Compose: generate a long hexadecimal value with openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# HOST_PORT=3000
# TRUST_PROXY=0
# SMTP_URL=smtp://username:password@mail.example.com:587
# SMTP_FROM=RipCord <noreply@example.com>
# Set to 1 only while developing behind a plain HTTP proxy.
# ALLOW_INSECURE_HTTP=1
